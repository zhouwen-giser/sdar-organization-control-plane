{
  "name": "@sdar/node-control-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:product": "node scripts/check-product.mjs",
    "lint": "npm run typecheck && npm run check:architecture && npm run check:product",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "validate": "npm run contract:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "validate:full": "npm run validate && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  },
  "description": "SDAR v1.4 single-node control console built from the frozen Node Control Backend contract"
}
